{
  "info": {
    "name": "SpringEduManager API",
    "description": "Etapa 5 - Interoperabilidad. CRUD REST de cursos y estudiantes. Dos formas de autenticarse: HTTP Basic (admin / admin123, configurado en la coleccion) o JWT: correr primero 'POST obtener token JWT' y despues las peticiones de la carpeta JWT usan {{jwt}} como Bearer. Importar en Postman: File > Import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{usuario}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{clave}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario",
      "value": "admin"
    },
    {
      "key": "clave",
      "value": "admin123"
    },
    {
      "key": "jwt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Cursos",
      "item": [
        {
          "name": "GET listar cursos",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y JSON', () => { pm.response.to.have.status(200); pm.response.to.be.json; });",
                  "pm.test('devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET curso por id",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/cursos/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('trae codigo y nombre', () => { const c = pm.response.json(); pm.expect(c).to.have.property('codigo'); pm.expect(c).to.have.property('nombre'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST crear curso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/cursos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Testing con JUnit\",\n  \"codigo\": \"QA-101\",\n  \"horas\": 30,\n  \"descripcion\": \"Pruebas unitarias y de integracion\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('cursoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST curso invalido (400 con detalle por campo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/cursos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"codigo\": \"\",\n  \"horas\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('dice que campos fallaron', () => pm.expect(pm.response.json().campos).to.have.keys('nombre','codigo','horas'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT actualizar curso",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/cursos/{{cursoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Testing con JUnit y Mockito\",\n  \"codigo\": \"QA-101\",\n  \"horas\": 40,\n  \"descripcion\": \"Actualizado desde Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('horas actualizadas', () => pm.expect(pm.response.json().horas).to.eql(40));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE eliminar curso",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/api/cursos/{{cursoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 sin contenido', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET curso inexistente (404)",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/cursos/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Estudiantes",
      "item": [
        {
          "name": "GET listar estudiantes",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/estudiantes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y JSON', () => { pm.response.to.have.status(200); pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST crear estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/estudiantes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pedro Rojas\",\n  \"email\": \"pedro@bootcamp.cl\",\n  \"rut\": \"11.222.333-4\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 creado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('estudianteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT actualizar estudiante",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/estudiantes/{{estudianteId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pedro Rojas Diaz\",\n  \"email\": \"pedro@bootcamp.cl\",\n  \"rut\": \"11.222.333-4\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE eliminar estudiante",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/api/estudiantes/{{estudianteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Evaluaciones (DTOs)",
      "item": [
        {
          "name": "GET listar evaluaciones",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/evaluaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y plano', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()[0]).to.have.property('aprobada'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET evaluaciones de un estudiante",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/evaluaciones/estudiante/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST registrar nota",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/evaluaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudianteId\": 1,\n  \"cursoId\": 2,\n  \"nota\": 6.8\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('evaluacionId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST nota a un no matriculado (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/evaluaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudianteId\": 2,\n  \"cursoId\": 1,\n  \"nota\": 5.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE eliminar evaluacion",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/api/evaluaciones/{{evaluacionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Seguridad",
      "item": [
        {
          "name": "GET sin credenciales (401, no redirige)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base}}/api/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('trae WWW-Authenticate', () => pm.response.to.have.header('WWW-Authenticate'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "JWT (plus)",
      "item": [
        {
          "name": "POST obtener token JWT",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"password\": \"{{clave}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().tipo).to.eql('Bearer'); });",
                  "pm.collectionVariables.set('jwt', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET cursos con Bearer",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base}}/api/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con JWT', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST token con clave incorrecta (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/api/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"incorrecta\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 en JSON', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error).to.include('incorrectos'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET cursos con Bearer invalido (401)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token.invalido.xyz",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{base}}/api/cursos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Interoperabilidad y estado",
      "item": [
        {
          "name": "GET calendario del campus (servicio externo simulado)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base}}/demo/campus/calendario"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 JSON', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET actuator health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}